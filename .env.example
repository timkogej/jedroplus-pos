# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# FURS certificate encryption
CERTIFICATE_ENCRYPTION_KEY=
FURS_TEST_URL=
FURS_PRODUCTION_URL=
# Software supplier tax number sent with BusinessPremiseRequest registration
FURS_SOFTWARE_SUPPLIER_TAX_NUMBER=

# Stripe (use sk_test_ in dev)
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_...) from `stripe listen` or the Dashboard
STRIPE_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=
# DEV ONLY: redirects ALL e-mail to this address. Leave empty in production!
RESEND_TEST_TO=

# App base URL
NEXT_PUBLIC_APP_URL=

# Booking frontend origin allowed to call /api/stripe/checkout (CORS).
# e.g. https://booking.jedroplus.si
BOOKING_ORIGIN=

# Vercel Cron auth. Set this in the Vercel project's env vars — Vercel then
# automatically sends it as `Authorization: Bearer $CRON_SECRET` on requests
# to the cron paths declared in vercel.json (generate with `openssl rand -hex 32`).
CRON_SECRET=

# FURS (optional)
# Verbose protocol logging (signed XML, headers, raw bodies). Leave unset in production.
FURS_DEBUG=
# Extra CA certificate(s) in PEM for verifying the FURS production server (SI-TRUST chain).
FURS_CA_PEM=
# Temporary escape hatch: set to "true" to skip TLS verification in PRODUCTION only.
FURS_TLS_INSECURE=

# Customer portal origin(s) allowed to call /api/portal/* (comma-separated).
PORTAL_ORIGINS=

# Stripe subscription price IDs (POS plans, from the Stripe dashboard)
STRIPE_POS_PLUS_MONTHLY=
STRIPE_POS_PLUS_YEARLY=
STRIPE_POS_PRO_MONTHLY=
STRIPE_POS_PRO_YEARLY=

# Sender address for e-mails (a domain verified in Resend)
RESEND_FROM_EMAIL=
